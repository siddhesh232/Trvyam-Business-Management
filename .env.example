# Copy to .env (never commit .env). Placeholders only.
ConnectionStrings__Default=Server=localhost,1433;Database=TrvyamBM;User Id=<user>;Password=<password>;TrustServerCertificate=True
Jwt__Issuer=trvyam-bm
Jwt__Audience=trvyam-bm-mobile
Jwt__SigningKey=<generate-32+-byte-random-secret>
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
Email__Provider=<smtp|sendgrid|ses>
Email__From=<no-reply@example.com>
Email__SmtpHost=<host>
Email__SmtpUser=<user>
Email__SmtpPassword=<password>
# Mobile (Frontend/.env)
API_BASE_URL=https://<your-api-host>/api/v1
